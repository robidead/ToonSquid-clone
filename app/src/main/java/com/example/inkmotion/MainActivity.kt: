enum class StudioTool {
    BRUSH, ERASER, FILL, LINE, RECT, OVAL, BONE_RIG, TRANSFORM, CAMERA
}

enum class LayerBlendPreset(val label: String, val mode: BlendMode) {
    NORMAL("Norm", BlendMode.SrcOver),
    MULTIPLY("Mult", BlendMode.Multiply),
    SCREEN("Scr", BlendMode.Screen),
    OVERLAY("Ovr", BlendMode.Overlay),
    DARKEN("Dark", BlendMode.Darken),
    LIGHTEN("Light", BlendMode.Lighten)
}

data class CameraKey(
    val x: Float = 0f,
    val y: Float = 0f,
    val zoom: Float = 1f
)

data class LayerTransformKey(
    val tx: Float = 0f,
    val ty: Float = 0f,
    val scale: Float = 1f,
    val rotationDeg: Float = 0f
)

data class StrokeItem(
    val points: List<Offset>,
    val color: Color,
    val width: Float,
    val isEraser: Boolean = false,
    val shapeType: StudioTool = StudioTool.BRUSH,
    val boundBoneId: Int? = null,
    val localBonePoints: List<Offset> = emptyList()
)

data class FillPatch(
    val bitmap: Bitmap,
    val offsetX: Float = 0f,
    val offsetY: Float = 0f
)

data class LayerItem(
    val id: Int,
    val name: String,
    var visible: Boolean = true,
    var alpha: Float = 1f,
    var blendPreset: LayerBlendPreset = LayerBlendPreset.NORMAL,
    var bindToSelectedBone: Boolean = false,
    val strokes: SnapshotStateList<StrokeItem> = mutableStateListOf(),
    val fills: SnapshotStateList<FillPatch> = mutableStateListOf(),
    val transformKeys: SnapshotStateMap<Int, LayerTransformKey> = mutableStateMapOf()
)

data class BoneDef(
    val id: Int,
    val name: String,
    val parentId: Int? = null,
    val length: Float = 110f,
    val baseAngleDeg: Float = -90f
)

data class AnimFrame(
    val number: Int,
    val layers: SnapshotStateList<LayerItem> = mutableStateListOf(
        LayerItem(id = 1, name = "Слой 1")
    ),
    val boneAngleOffsets: SnapshotStateMap<Int, Float> = mutableStateMapOf()
)

data class SolvedBoneNode(
    val bone: BoneDef,
    val start: Offset,
    val end: Offset,
    val worldAngleDeg: Float
)

