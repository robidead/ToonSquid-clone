@Composable
fun InkMotionFullStudio() {
    val context = LocalContext.current
    val scope = rememberCoroutineScope()

    val bones = remember {
        mutableStateListOf(
            BoneDef(1, "Торс", null, 115f, -90f),
            BoneDef(2, "Голова", 1, 65f, -90f),
            BoneDef(3, "Рука L", 1, 95f, -150f),
            BoneDef(4, "Рука R", 1, 95f, -30f)
        )
    }
    var selectedBoneId by remember { mutableIntStateOf(1) }
    var skeletonOrigin by remember { mutableStateOf(Offset(540f, 820f)) }
    val copiedPoseBuffer = remember { mutableStateMapOf<Int, Float>() }

    val frames = remember { mutableStateListOf(AnimFrame(1)) }
    val cameraKeys = remember { mutableStateMapOf<Int, CameraKey>() }
    var currentFrameIdx by remember { mutableIntStateOf(0) }
    var activeLayerIdx by remember { mutableIntStateOf(0) }

    var tool by remember { mutableStateOf(StudioTool.BRUSH) }
    var selectedColor by remember { mutableStateOf(Color(0xFF111111)) }
    var strokeWidth by remember { mutableFloatStateOf(10f) }
    var fps by remember { mutableIntStateOf(12) }
    var isPlaying by remember { mutableStateOf(false) }
    var isExporting by remember { mutableStateOf(false) }
    var onionSkin by remember { mutableStateOf(true) }
    var showBones by remember { mutableStateOf(true) }
    var showCameraGuide by remember { mutableStateOf(true) }
    var showGrid by remember { mutableStateOf(false) }
    var tweenEnabled by remember { mutableStateOf(true) }
    var showLayersDrawer by remember { mutableStateOf(false) }

    var audioUri by remember { mutableStateOf<Uri?>(null) }
    var audioName by remember { mutableStateOf<String?>(null) }
    var audioStartFrame by remember { mutableIntStateOf(0) }
    var mediaPlayer by remember { mutableStateOf<MediaPlayer?>(null) }

    var livePoints by remember { mutableStateOf<List<Offset>>(emptyList()) }
    var canvasSizePx by remember { mutableStateOf(androidx.compose.ui.unit.IntSize.Zero) }

    val audioPicker = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.GetContent()
    ) { uri: Uri? ->
        if (uri != null) {
            mediaPlayer?.release()
            mediaPlayer = null
            audioUri = uri
            audioName = uri.lastPathSegment ?: "Аудио"
            audioStartFrame = currentFrameIdx
            try {
                val mp = MediaPlayer().apply {
                    setDataSource(context, uri)
                    prepare()
                }
                mediaPlayer = mp
                Toast.makeText(context, "Аудио загружено", Toast.LENGTH_SHORT).show()
            } catch (_: Exception) {
                Toast.makeText(context, "Не удалось прочитать аудио", Toast.LENGTH_SHORT).show()
            }
        }
    }

    val projectLoader = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.GetContent()
    ) { uri: Uri? ->
        if (uri != null) {
            try {
                val jsonText = context.contentResolver.openInputStream(uri)?.bufferedReader()?.use { it.readText() }
                if (!jsonText.isNullOrBlank()) {
                    loadProjectFromJson(
                        jsonText = jsonText,
                        bones = bones,
                        frames = frames,
                        cameraKeys = cameraKeys,
                        onOriginLoaded = { skeletonOrigin = it },
                        onFpsLoaded = { fps = it }
                    )
                    currentFrameIdx = 0
                    activeLayerIdx = 0
                    Toast.makeText(context, "Проект загружен", Toast.LENGTH_SHORT).show()
                }
            } catch (_: Exception) {
                Toast.makeText(context, "Ошибка загрузки проекта", Toast.LENGTH_SHORT).show()
            }
        }
    }

    DisposableEffect(Unit) {
        onDispose {
            mediaPlayer?.release()
            mediaPlayer = null
        }
    }

    val currentFrame = frames.getOrElse(currentFrameIdx) { frames.first() }
    if (activeLayerIdx >= currentFrame.layers.size) {
        activeLayerIdx = (currentFrame.layers.size - 1).coerceAtLeast(0)
    }
    val activeLayer = currentFrame.layers.getOrNull(activeLayerIdx)

    LaunchedEffect(isPlaying, isExporting, fps, frames.size) {
        if (isPlaying && !isExporting && frames.isNotEmpty()) {
            val mp = mediaPlayer
            if (mp != null) {
                val offsetMs = ((currentFrameIdx - audioStartFrame).coerceAtLeast(0) * 1000L) / fps.coerceIn(1, 60)
                try {
                    mp.seekTo(offsetMs.toInt().coerceAtMost(mp.duration.coerceAtLeast(0)))
                    mp.start()
                } catch (_: Exception) {}
            }
            while (isPlaying && !isExporting && frames.isNotEmpty()) {
                delay(1000L / fps.coerceIn(1, 60))
                currentFrameIdx = (currentFrameIdx + 1) % frames.size
            }
        } else {
            try {
                if (mediaPlayer?.isPlaying == true) mediaPlayer?.pause()
            } catch (_: Exception) {}
        }
    }

    val resolvedBoneOffsets: Map<Int, Float> = remember(frames.toList(), currentFrameIdx, tweenEnabled, bones.toList()) {
        bones.associate { b ->
            b.id to resolveBoneOffset(frames, currentFrameIdx, b.id, tweenEnabled)
        }
    }

    val solvedBones: List<SolvedBoneNode> = remember(bones.toList(), skeletonOrigin, resolvedBoneOffsets) {
        solveBoneHierarchy(bones, skeletonOrigin, resolvedBoneOffsets)
    }

    val currentCamera: CameraKey = remember(cameraKeys.toMap(), currentFrameIdx, tweenEnabled) {
        resolveCameraKey(cameraKeys, currentFrameIdx, tweenEnabled)
    }

    val selectedBone = bones.find { it.id == selectedBoneId } ?: bones.firstOrNull()
    val selectedBoneAngle = selectedBone?.let { resolvedBoneOffsets[it.id] ?: 0f } ?: 0f

    val activeLayerTransform = remember(activeLayer, currentFrameIdx, tweenEnabled, frames.size) {
        if (activeLayer == null) LayerTransformKey()
        else resolveLayerTransform(activeLayer, currentFrameIdx, tweenEnabled)
    }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(Color(0xFF121417))
            .systemBarsPadding()
    ) {
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .background(Color(0xFF1C1F26))
                .padding(horizontal = 8.dp, vertical = 5.dp),
            verticalAlignment = Alignment.CenterVertically,
            horizontalArrangement = Arrangement.SpaceBetween
        ) {
            Text("InkMotion", color = Color.White, fontWeight = FontWeight.Bold, fontSize = 15.sp)

            LazyRow(
                verticalAlignment = Alignment.CenterVertically,
                horizontalArrangement = Arrangement.spacedBy(4.dp),
                modifier = Modifier.weight(1f).padding(horizontal = 6.dp)
            ) {
                item { SmallChip("Калька", onionSkin) { onionSkin = !onionSkin } }
                item { SmallChip("Кости", showBones) { showBones = !showBones } }
                item { SmallChip("Кам.", showCameraGuide) { showCameraGuide = !showCameraGuide } }
                item { SmallChip("Сетка", showGrid) { showGrid = !showGrid } }
                item {
                    SmallChip("Звук", audioUri != null) {
                        audioPicker.launch("audio/*")
                    }
                }
                item {
                    SmallChip("Сохр.", false) {
                        val json = exportProjectToJson(frames, bones, cameraKeys, skeletonOrigin, fps)
                        val saved = saveTextProject(context, json, "InkMotion_proj_${System.currentTimeMillis()}")
                        Toast.makeText(
                            context,
                            if (saved) "Проект сохранён (.json)" else "Ошибка сохранения",
                            Toast.LENGTH_SHORT
                        ).show()
                    }
                }
                item {
                    SmallChip("Откр.", false) {
                        projectLoader.launch("*/*")
                    }
                }
                item {
                    SmallChip("${fps}FPS", false) {
                        fps = when (fps) {
                            8 -> 12
                            12 -> 24
                            else -> 8
                        }
                    }
                }
                item {
                    SmallChip("PNG", false) {
                        if (canvasSizePx.width > 0 && canvasSizePx.height > 0) {
                            val bmp = renderFullFrame(
                                width = canvasSizePx.width,
                                height = canvasSizePx.height,
                                frame = currentFrame,
                                frameIndex = currentFrameIdx,
                                solvedBones = solvedBones,
                                camera = currentCamera,
                                drawBonesOverlay = showBones,
                                tweenEnabled = tweenEnabled
                            )
                            val ok = savePngToGallery(
                                context,
                                bmp,
                                "InkMotion_f${currentFrameIdx + 1}_${System.currentTimeMillis()}"
                            )
                            Toast.makeText(
                                context,
                                if (ok) "PNG сохранён" else "Ошибка PNG",
                                Toast.LENGTH_SHORT
                            ).show()
                        }
                    }
                }
                item {
                    SmallChip(if (isExporting) "..." else "MP4", false) {
                        if (!isExporting && canvasSizePx.width > 0 && canvasSizePx.height > 0) {
                            isExporting = true
                            isPlaying = false
                            scope.launch {
                                val outFile = exportAnimationToMp4(
                                    context = context,
                                    frames = frames.toList(),
                                    bones = bones.toList(),
                                    cameraKeys = cameraKeys.toMap(),
                                    rootOrigin = skeletonOrigin,
                                    tweenEnabled = tweenEnabled,
                                    fps = fps,
                                    baseWidth = canvasSizePx.width,
                                    baseHeight = canvasSizePx.height
                                )
                                isExporting = false
                                Toast.makeText(
                                    context,
                                    if (outFile != null) "MP4 готов: ${outFile.name}" else "Ошибка MP4",
                                    Toast.LENGTH_LONG
                                ).show()
                            }
                        }
                    }
                }
            }

            Button(
                onClick = { isPlaying = !isPlaying },
                contentPadding = PaddingValues(horizontal = 9.dp, vertical = 2.dp),
                modifier = Modifier.height(32.dp)
            ) {
                Text(if (isPlaying) "Стоп" else "Пуск", fontSize = 11.sp)
            }
        }

        if (audioName != null) {
            Row(
                modifier = Modifier
                    .fillMaxWidth()
                    .background(Color(0xFF19222B))
                    .padding(horizontal = 8.dp, vertical = 3.dp),
                verticalAlignment = Alignment.CenterVertically,
                horizontalArrangement = Arrangement.SpaceBetween
            ) {
                Text(
                    "♪ $audioName (старт: кадр ${audioStartFrame + 1})",
                    color = Color(0xFF72EFDD),
                    fontSize = 11.sp,
                    modifier = Modifier.weight(1f)
                )
                SmallChip("Старт тут", false) {
                    audioStartFrame = currentFrameIdx
                }
                Spacer(modifier = Modifier.width(4.dp))
                SmallChip("Убрать", false) {
                    mediaPlayer?.release()
                    mediaPlayer = null
                    audioUri = null
                    audioName = null
                }
            }
        }

        Column(
            modifier = Modifier
                .fillMaxWidth()
                .background(Color(0xFF171A21))
                .padding(horizontal = 8.dp, vertical = 5.dp),
            verticalArrangement = Arrangement.spacedBy(5.dp)
        ) {
            LazyRow(
                horizontalArrangement = Arrangement.spacedBy(5.dp),
                verticalAlignment = Alignment.CenterVertically
            ) {
                item { ToolBadge("Кисть", tool == StudioTool.BRUSH) { tool = StudioTool.BRUSH } }
                item { ToolBadge("Ластик", tool == StudioTool.ERASER) { tool = StudioTool.ERASER } }
                item { ToolBadge("Заливка", tool == StudioTool.FILL) { tool = StudioTool.FILL } }
                item { ToolBadge("Линия", tool == StudioTool.LINE) { tool = StudioTool.LINE } }
                item { ToolBadge("Прям.", tool == StudioTool.RECT) { tool = StudioTool.RECT } }
                item { ToolBadge("Овал", tool == StudioTool.OVAL) { tool = StudioTool.OVAL } }
                item {
                    ToolBadge("Кости", tool == StudioTool.BONE_RIG) {
                        tool = StudioTool.BONE_RIG
                        showBones = true
                    }
                }
                item { ToolBadge("Трансф.", tool == StudioTool.TRANSFORM) { tool = StudioTool.TRANSFORM } }
                item {
                    ToolBadge("Камера", tool == StudioTool.CAMERA) {
                        tool = StudioTool.CAMERA
                        showCameraGuide = true
                    }
                }
                item {
                    ToolBadge("Слои (${currentFrame.layers.size})", showLayersDrawer) {
                        showLayersDrawer = !showLayersDrawer
                    }
                }
                item {
                    ToolBadge("Отзерк. X", false) {
                        if (activeLayer != null && canvasSizePx.width > 0) {
                            mirrorLayerHorizontal(activeLayer, canvasSizePx.width.toFloat())
                        }
                    }
                }
                item {
                    ToolBadge("Очистить", false) {
                        if (activeLayer != null) {
                   
